{
  "entities": {
    "UserProgress": {
      "title": "UserProgress",
      "description": "Authenticated learner profile, XP, streak, collection points, module/quiz progress, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["learner", "admin"] },
        "xp": { "type": "integer" },
        "streak": { "type": "integer" },
        "collectionPoints": { "type": "integer" },
        "modules": { "type": "object" },
        "quizzes": { "type": "object" },
        "reviewedCards": { "type": "array" },
        "listenedWords": { "type": "array" },
        "visitedSites": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "xp", "streak", "collectionPoints", "createdAt", "updatedAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Trusted administrator marker document keyed by Firebase Auth UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "LessonArticle": {
      "title": "LessonArticle",
      "description": "Admin-authored rich-text Creole micro-lesson or cultural guide with optional picture/file attachment",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 140 },
        "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "master"] },
        "creoleSummary": { "type": "string", "maxLength": 400 },
        "bodyHtml": { "type": "string", "maxLength": 40000 },
        "funFact": { "type": "string", "maxLength": 600 },
        "imageUrl": { "type": "string", "maxLength": 200000 },
        "attachmentName": { "type": "string", "maxLength": 160 },
        "attachmentUrl": { "type": "string", "maxLength": 200000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "level", "creoleSummary", "bodyHtml", "authorId", "createdAt", "updatedAt"]
    },
    "DictionaryEntry": {
      "title": "DictionaryEntry",
      "description": "Custom Martinican Creole dictionary & flashcard term published via Admin Console",
      "type": "object",
      "properties": {
        "word": { "type": "string", "maxLength": 120 },
        "pos": { "type": "string", "maxLength": 40 },
        "pronounce": { "type": "string", "maxLength": 120 },
        "en": { "type": "string", "maxLength": 200 },
        "fr": { "type": "string", "maxLength": 200 },
        "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "master"] },
        "explanation": { "type": "string", "maxLength": 600 },
        "funFact": { "type": "string", "maxLength": 400 },
        "example": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 200000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["word", "pos", "en", "fr", "level", "authorId", "createdAt", "updatedAt"]
    },
    "KoudmenPost": {
      "title": "KoudmenPost",
      "description": "Community Koudmen question or cultural note with bounded upvoter tracking",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 80 },
        "topic": { "type": "string", "enum": ["grammar", "culture", "pronunciation", "history"] },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 2000 },
        "upvotes": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "topic", "title", "body", "upvotes", "createdAt", "updatedAt"]
    },
    "MapLocation": {
      "title": "MapLocation",
      "description": "Dynamic Martinique cultural map point of interest (commune, historical site, or off-the-beaten-path landmark)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 140 },
        "creoleName": { "type": "string", "maxLength": 180 },
        "category": { "type": "string", "enum": ["commune", "historical", "offbeat"] },
        "region": { "type": "string", "maxLength": 120 },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "audioPhrase": { "type": "string", "maxLength": 240 },
        "fact": { "type": "string", "maxLength": 1200 },
        "tradition": { "type": "string", "maxLength": 800 },
        "proverb": { "type": "string", "maxLength": 400 },
        "imageUrl": { "type": "string", "maxLength": 200000 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "creoleName", "category", "region", "lat", "lng", "fact", "authorId", "createdAt", "updatedAt"]
    },
    "ProverbAffirmation": {
      "title": "ProverbAffirmation",
      "description": "Martinican Creole daily affirmation and ancestral proverb stored in Firestore for the hero wall",
      "type": "object",
      "properties": {
        "creole": { "type": "string", "maxLength": 320 },
        "phonetic": { "type": "string", "maxLength": 320 },
        "en": { "type": "string", "maxLength": 360 },
        "fr": { "type": "string", "maxLength": 360 },
        "meaning": { "type": "string", "maxLength": 600 },
        "origin": { "type": "string", "maxLength": 140 },
        "authorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["creole", "en", "fr", "authorId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Private learner progress and profile state, readable and writable only by the owning authenticated user or an admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Trusted admin role documents; readable only by owner or admin."
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonArticle" },
      "description": "Rich-text micro-lessons and uploaded media guides published by admins."
    },
    "/dictionary/{entryId}": {
      "schema": { "$ref": "#/entities/DictionaryEntry" },
      "description": "Extended Martinican Creole dictionary entries managed by admins."
    },
    "/koudmen/{postId}": {
      "schema": { "$ref": "#/entities/KoudmenPost" },
      "description": "Community Koudmen peer-learning posts."
    },
    "/mapLocations/{locationId}": {
      "schema": { "$ref": "#/entities/MapLocation" },
      "description": "Dynamic Leaflet OSM markers for communes, historical sites, and off-the-beaten-path heritage points."
    },
    "/proverbs/{proverbId}": {
      "schema": { "$ref": "#/entities/ProverbAffirmation" },
      "description": "Cultural Martinican Creole proverbs and daily affirmations surfaced randomly on the hero wall."
    }
  }
}
