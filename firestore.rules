rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'banheruka@gmail.com'
      );
    }

    function isBoundedStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (
        arr.size() == 0 ||
        (arr[0] is string && arr[0].size() <= 160 && arr[arr.size() - 1] is string && arr[arr.size() - 1].size() <= 160)
      );
    }

    function isValidUserProgress(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'xp', 'streak', 'collectionPoints', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'xp', 'streak', 'collectionPoints',
          'modules', 'quizzes', 'reviewedCards', 'listenedWords', 'visitedSites',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid.size() <= 128 && data.uid == userId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.role is string && data.role.size() <= 16 && (data.role == 'learner' || data.role == 'admin')
        && data.xp is int && data.xp >= 0 && data.xp <= 1000000
        && data.streak is int && data.streak >= 0 && data.streak <= 10000
        && data.collectionPoints is int && data.collectionPoints >= 0 && data.collectionPoints <= 1000000
        && (!('modules' in data) || data.modules is map)
        && (!('quizzes' in data) || data.quizzes is map)
        && (!('reviewedCards' in data) || isBoundedStringArray(data.reviewedCards, 200))
        && (!('listenedWords' in data) || isBoundedStringArray(data.listenedWords, 200))
        && (!('visitedSites' in data) || isBoundedStringArray(data.visitedSites, 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMember(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == userId
        && data.email is string && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidLessonArticle(data) {
      return data.keys().hasAll(['title', 'level', 'creoleSummary', 'bodyHtml', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'title', 'level', 'creoleSummary', 'bodyHtml', 'funFact',
          'imageUrl', 'attachmentName', 'attachmentUrl', 'authorId', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.level is string && data.level.size() <= 24 && data.level in ['beginner', 'intermediate', 'advanced', 'master']
        && data.creoleSummary is string && data.creoleSummary.size() >= 2 && data.creoleSummary.size() <= 400
        && data.bodyHtml is string && data.bodyHtml.size() >= 2 && data.bodyHtml.size() <= 40000
        && (!('funFact' in data) || (data.funFact is string && data.funFact.size() <= 600))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 200000))
        && (!('attachmentName' in data) || (data.attachmentName is string && data.attachmentName.size() <= 160))
        && (!('attachmentUrl' in data) || (data.attachmentUrl is string && data.attachmentUrl.size() <= 200000))
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDictionaryEntry(data) {
      return data.keys().hasAll(['word', 'pos', 'en', 'fr', 'level', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'word', 'pos', 'pronounce', 'en', 'fr', 'level', 'explanation',
          'funFact', 'example', 'imageUrl', 'authorId', 'createdAt', 'updatedAt'
        ])
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 120
        && data.pos is string && data.pos.size() >= 1 && data.pos.size() <= 40
        && (!('pronounce' in data) || (data.pronounce is string && data.pronounce.size() <= 120))
        && data.en is string && data.en.size() >= 1 && data.en.size() <= 200
        && data.fr is string && data.fr.size() >= 1 && data.fr.size() <= 200
        && data.level is string && data.level.size() <= 24 && data.level in ['beginner', 'intermediate', 'advanced', 'master']
        && (!('explanation' in data) || (data.explanation is string && data.explanation.size() <= 600))
        && (!('funFact' in data) || (data.funFact is string && data.funFact.size() <= 400))
        && (!('example' in data) || (data.example is string && data.example.size() <= 300))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 200000))
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidKoudmenPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'topic', 'title', 'body', 'upvotes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'topic', 'title', 'body', 'upvotes', 'createdAt', 'updatedAt'])
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.topic is string && data.topic.size() <= 24 && data.topic in ['grammar', 'culture', 'pronunciation', 'history']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 2000
        && data.upvotes is int && data.upvotes >= 0 && data.upvotes <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMapLocation(data, locationId) {
      return data.keys().hasAll(['id', 'name', 'creoleName', 'category', 'region', 'lat', 'lng', 'fact', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'creoleName', 'category', 'region', 'lat', 'lng',
          'audioPhrase', 'fact', 'tradition', 'proverb', 'imageUrl', 'authorId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() <= 128 && data.id == locationId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.creoleName is string && data.creoleName.size() >= 2 && data.creoleName.size() <= 180
        && data.category is string && data.category.size() <= 24 && data.category in ['commune', 'historical', 'offbeat']
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 120
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && (!('audioPhrase' in data) || (data.audioPhrase is string && data.audioPhrase.size() <= 240))
        && data.fact is string && data.fact.size() >= 4 && data.fact.size() <= 1200
        && (!('tradition' in data) || (data.tradition is string && data.tradition.size() <= 800))
        && (!('proverb' in data) || (data.proverb is string && data.proverb.size() <= 400))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 200000))
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users Collection (PII strictly isolated to owner or admin)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProgress(incoming(), userId)
        && incoming().role == 'learner'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'email', 'xp', 'streak', 'collectionPoints',
              'modules', 'quizzes', 'reviewedCards', 'listenedWords', 'visitedSites', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isAdmin()
        && isValidAdminMember(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admin-Authored Rich-Text Lessons
    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId);
      allow list: if true;
      allow create: if isValidId(lessonId)
        && isAdmin()
        && isValidLessonArticle(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(lessonId)
        && isAdmin()
        && isValidLessonArticle(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'level', 'creoleSummary', 'bodyHtml', 'funFact',
          'imageUrl', 'attachmentName', 'attachmentUrl', 'updatedAt'
        ]);
      allow delete: if isValidId(lessonId) && isAdmin();
    }

    // Admin-Authored Dictionary Entries
    match /dictionary/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create: if isValidId(entryId)
        && isAdmin()
        && isValidDictionaryEntry(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(entryId)
        && isAdmin()
        && isValidDictionaryEntry(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'word', 'pos', 'pronounce', 'en', 'fr', 'level', 'explanation',
          'funFact', 'example', 'imageUrl', 'updatedAt'
        ]);
      allow delete: if isValidId(entryId) && isAdmin();
    }

    // Community Koudmen Posts
    match /koudmen/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create: if isValidId(postId)
        && isVerifiedUser()
        && isValidKoudmenPost(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().upvotes == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(postId)
        && isVerifiedUser()
        && isValidKoudmenPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'title', 'body', 'updatedAt'])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt'])
            && incoming().upvotes == existing().upvotes + 1
          )
        );
      allow delete: if isValidId(postId) && (isAdmin() || (isVerifiedUser() && existing().authorId == request.auth.uid));
    }

    // Dynamic Martinique Heritage Map Locations (Historical Sites, Offbeat & Communes)
    match /mapLocations/{locationId} {
      allow get: if isValidId(locationId);
      allow list: if true;
      allow create: if isValidId(locationId)
        && isAdmin()
        && isValidMapLocation(incoming(), locationId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(locationId)
        && isAdmin()
        && isValidMapLocation(incoming(), locationId)
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'creoleName', 'category', 'region', 'lat', 'lng',
          'audioPhrase', 'fact', 'tradition', 'proverb', 'imageUrl', 'updatedAt'
        ]);
      allow delete: if isValidId(locationId) && isAdmin();
    }

    function isValidProverb(data) {
      return data.keys().hasAll(['creole', 'en', 'fr', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'creole', 'phonetic', 'en', 'fr', 'meaning', 'origin',
          'authorId', 'createdAt', 'updatedAt'
        ])
        && data.creole is string && data.creole.size() >= 2 && data.creole.size() <= 320
        && (!('phonetic' in data) || (data.phonetic is string && data.phonetic.size() <= 320))
        && data.en is string && data.en.size() >= 2 && data.en.size() <= 360
        && data.fr is string && data.fr.size() >= 2 && data.fr.size() <= 360
        && (!('meaning' in data) || (data.meaning is string && data.meaning.size() <= 600))
        && (!('origin' in data) || (data.origin is string && data.origin.size() <= 140))
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Cultural Proverbs & Daily Affirmations
    match /proverbs/{proverbId} {
      allow get: if isValidId(proverbId);
      allow list: if true;
      allow create: if isValidId(proverbId)
        && isAdmin()
        && isValidProverb(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(proverbId)
        && isAdmin()
        && isValidProverb(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'creole', 'phonetic', 'en', 'fr', 'meaning', 'origin', 'updatedAt'
        ]);
      allow delete: if isValidId(proverbId) && isAdmin();
    }

    function isValidVocabCard(card) {
      return card is map
        && card.keys().hasAll(['word', 'en', 'fr'])
        && card.keys().hasOnly(['word', 'pronounce', 'pos', 'en', 'fr', 'ex', 'definition', 'funFact'])
        && card.word is string && card.word.size() >= 1 && card.word.size() <= 120
        && card.en is string && card.en.size() >= 1 && card.en.size() <= 200
        && card.fr is string && card.fr.size() >= 1 && card.fr.size() <= 200
        && (!('pronounce' in card) || (card.pronounce is string && card.pronounce.size() <= 120))
        && (!('pos' in card) || (card.pos is string && card.pos.size() <= 40))
        && (!('ex' in card) || (card.ex is string && card.ex.size() <= 300))
        && (!('definition' in card) || (card.definition is string && card.definition.size() <= 400))
        && (!('funFact' in card) || (card.funFact is string && card.funFact.size() <= 400));
    }

    function isValidVocabSet(data, setId) {
      return data.keys().hasAll(['id', 'title', 'level', 'unlockStep', 'cards', 'cardCount', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'title', 'level', 'unlockStep', 'imageUrl', 'cards', 'cardCount',
          'authorId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 64 && data.id == setId
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.level is string && data.level.size() <= 24 && data.level in ['beginner', 'intermediate', 'advanced', 'master']
        && data.unlockStep is int && data.unlockStep >= 1 && data.unlockStep <= 6
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 200000))
        && data.cards is list && data.cards.size() >= 1 && data.cards.size() <= 30
        && isValidVocabCard(data.cards[0])
        && isValidVocabCard(data.cards[data.cards.size() - 1])
        && data.cardCount is int && data.cardCount == data.cards.size()
        && data.authorId is string && data.authorId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Dynamic Vocabulary Sets & Flashcard Decks
    match /vocabSets/{setId} {
      allow get: if isValidId(setId);
      allow list: if true;
      allow create: if isValidId(setId)
        && isAdmin()
        && isValidVocabSet(incoming(), setId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(setId)
        && isAdmin()
        && isValidVocabSet(incoming(), setId)
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'level', 'unlockStep', 'imageUrl', 'cards', 'cardCount', 'updatedAt'
        ]);
      allow delete: if isValidId(setId) && isAdmin();
    }
  }
}
