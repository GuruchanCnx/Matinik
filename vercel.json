{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/firebase/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/vendor/firebase/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!src/|public/|api/|vendor/|uploads/|firebase-applet-config\\.json|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
